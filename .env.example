# 复制为 .env 后填写随机强口令；此文件不得填写或提交真实生产密钥。
MYSQL_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
# 生成方式示例：openssl rand -base64 32
MFA_ENCRYPTION_KEY=CHANGE_ME_WITH_BASE64_32_RANDOM_BYTES
# 登录MFA总闸门默认必须开启；仅故障恢复窗口临时设为false，短信验收后立即恢复true。
MFA_ENFORCEMENT_ENABLED=true
MFA_REQUIRED_ROLES=boss,super_admin,finance_hq

# 可选邮件配置
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_FROM_NAME=浙杭集团
