<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhehang.erp.modules.system.mapper.SysMenuMapper">

    <resultMap id="RouterMenuResultMap" type="com.zhehang.erp.modules.system.domain.entity.SysMenu">
        <id property="id" column="id"/>
        <result property="menuName" column="menu_name"/>
        <result property="parentId" column="parent_id"/>
        <result property="orderNum" column="sort"/>
        <result property="path" column="path"/>
        <result property="component" column="component"/>
        <result property="visible" column="visible"/>
        <result property="status" column="status"/>
        <result property="perms" column="perms"/>
        <result property="icon" column="icon"/>
    </resultMap>

    <select id="selectMenusByUserId" resultMap="RouterMenuResultMap">
        SELECT DISTINCT
            m.id,
            m.menu_name,
            m.parent_id,
            m.sort,
            m.path,
            m.component,
            m.visible,
            m.status,
            m.perms,
            m.icon
        FROM sys_menu m
        INNER JOIN sys_role_menu rm ON rm.menu_id = m.id
        INNER JOIN sys_user_role ur ON ur.role_id = rm.role_id
        WHERE ur.user_id = #{userId}
          AND m.deleted = 0
          AND m.status = 0
        ORDER BY m.sort ASC, m.id ASC
    </select>

    <select id="selectMenuIdsByRoleId" resultType="java.lang.Long">
        SELECT menu_id
        FROM sys_role_menu
        WHERE role_id = #{roleId}
    </select>

</mapper>
